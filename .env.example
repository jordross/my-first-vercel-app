# Copy to .env.local (or set in Vercel / GitHub secrets). Unset values are hidden on the site.

# Shown in the header, contact section and used as the mailto fallback.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional form service endpoint that accepts JSON POSTs, e.g. https://formspree.io/f/xxxxxxx
# If unset, the form opens the visitor's email app addressed to NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_FORM_ENDPOINT=
